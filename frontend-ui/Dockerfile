FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Accept build args
ARG REACT_APP_API_URL
ARG REACT_APP_BRAND_NAME
ARG REACT_APP_BRAND_LOGO
ARG REACT_APP_BRAND_LOGO_URL
ARG REACT_APP_PRIMARY_COLOR
ARG REACT_APP_SECONDARY_COLOR
ARG REACT_APP_WIDGET_DOMAIN

# Set environment variables for build
ENV REACT_APP_API_URL=$REACT_APP_API_URL
ENV REACT_APP_BRAND_NAME=$REACT_APP_BRAND_NAME
ENV REACT_APP_BRAND_LOGO=$REACT_APP_BRAND_LOGO
ENV REACT_APP_BRAND_LOGO_URL=$REACT_APP_BRAND_LOGO_URL
ENV REACT_APP_PRIMARY_COLOR=$REACT_APP_PRIMARY_COLOR
ENV REACT_APP_SECONDARY_COLOR=$REACT_APP_SECONDARY_COLOR
ENV REACT_APP_WIDGET_DOMAIN=$REACT_APP_WIDGET_DOMAIN

# Build for production
RUN npm run build

# Install serve to serve static files
RUN npm install -g serve

# Expose port
EXPOSE 3000

# Serve built files
CMD ["serve", "-s", "build", "-l", "3000"]